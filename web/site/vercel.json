{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "task/*": false,
      "spike/*": false
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ."
}
