class_name BuildFootprint extends RefCounted
## Footprint cells of 03 s3.6: a w x h rectangle rotated in 90 degree steps, generated by stepping
## `Sphere.neighbour_cell` from the anchor (never rectangle arithmetic inside one face), so it may straddle a cube
## edge or corner. The walk carries a (u, v) direction frame and re-derives it when a step changes face. At a cube
## corner one quadrant does not exist; duplicate cells are dropped, so the footprint has fewer than w * h cells.
## The anchor is the centre cell: the walk first steps back floor(w / 2) and floor(h / 2).

const _UD: PackedInt32Array = [Sphere.DIR_POS_U, Sphere.DIR_POS_V, Sphere.DIR_NEG_U, Sphere.DIR_NEG_V]
const _VD: PackedInt32Array = [Sphere.DIR_POS_V, Sphere.DIR_NEG_U, Sphere.DIR_NEG_V, Sphere.DIR_POS_U]

var n: int = Sphere.GRID_BUILD
var crossed: bool = false   ## the last cells() call changed face at least once
var _out: PackedInt32Array = PackedInt32Array()
var _ud: int = 0
var _vd: int = 0


func _init(grid_n: int = Sphere.GRID_BUILD) -> void:
	n = grid_n


## Unique footprint cells; the array is reused by the next call (copy-on-write for the caller).
func cells(anchor: int, w: int, h: int, rotation: int) -> PackedInt32Array:
	var _r: int = _out.resize(0)
	crossed = false
	_ud = _UD[rotation & 3]
	_vd = _VD[rotation & 3]
	var c: int = _walk(anchor, false, -1, w >> 1)
	c = _walk(c, true, -1, h >> 1)
	for b: int in h:
		var ud0: int = _ud
		var vd0: int = _vd
		var x: int = c
		for a: int in w:
			if not crossed or not _out.has(x):
				var _p: bool = _out.push_back(x)
			if a < w - 1:
				x = _walk(x, false, 1, 1)
		_ud = ud0
		_vd = vd0
		if b < h - 1:
			c = _walk(c, true, 1, 1)
	return _out


## Mean direction of the footprint cells (unit vector), the "footprint centre" of 02 s6.2.
func centre_dir() -> Vector3:
	var s: Vector3 = Vector3.ZERO
	for c: int in _out:
		s += Sphere.cell_center_dir(c, n)
	return s.normalized()


func _walk(cell: int, use_v: bool, sign_step: int, steps: int) -> int:
	var c: int = cell
	for _i: int in steps:
		var axis: int = _vd if use_v else _ud
		var d: int = (axis ^ 1) if sign_step < 0 else axis
		var nx: int = Sphere.neighbour_cell(c, n, d)
		if Sphere.cell_face(nx, n) != Sphere.cell_face(c, n):
			crossed = true
			_reframe(c, nx, d, use_v, sign_step < 0)
		c = nx
	return c


func _reframe(old: int, nx: int, d: int, use_v: bool, back: bool) -> void:
	var face: int = Sphere.cell_face(old, n)
	var nd: int = Sphere.EDGE_NEIGHBOUR[(face * 4 + d) * Sphere.EDGE_NEIGHBOUR_STRIDE + 1] ^ 1
	var perp_old: int = _ud if use_v else _vd
	var t_old: Vector3 = Sphere.cell_center_dir(Sphere.neighbour_cell(old, n, perp_old), n) - Sphere.cell_center_dir(old, n)
	var c0: int = Sphere.DIR_NEG_V if nd < Sphere.DIR_NEG_V else Sphere.DIR_NEG_U
	var here: Vector3 = Sphere.cell_center_dir(nx, n)
	var ta: Vector3 = Sphere.cell_center_dir(Sphere.neighbour_cell(nx, n, c0), n) - here
	var tb: Vector3 = Sphere.cell_center_dir(Sphere.neighbour_cell(nx, n, c0 + 1), n) - here
	var perp_new: int = c0 if ta.dot(t_old) >= tb.dot(t_old) else c0 + 1
	var axis_new: int = (nd ^ 1) if back else nd
	if use_v:
		_vd = axis_new
		_ud = perp_new
	else:
		_ud = axis_new
		_vd = perp_new
