{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wing.schema.json",
  "title": "WingDef (godot/content/defs/wing.json)",
  "$comment": "08 SL-2 data block (FEAT-01). Singleton: no id, status or tags (as scoring.json).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "_doc": {
      "$ref": "#/$defs/doc"
    },
    "max_wingmen": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "$comment": "08 SL-2 rule 1: 2 (3 slots if the cap is raised)"
    },
    "recruit_radius_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000,
      "$comment": "08 SL-2 rule 1: 1,500 m"
    },
    "min_fuel01": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "$comment": "08 SL-2 rule 1: fuel01 >= 0.4"
    },
    "min_hp01": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "$comment": "08 SL-2 rule 1: hp01 >= 0.5"
    },
    "min_speed_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "$comment": "08 SL-2 rule 1: cruise >= 0.9 x leader"
    },
    "recruit_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "AUTO",
          "PATROL"
        ]
      },
      "$comment": "08 SL-2 rule 1: AUTO or on PATROL"
    },
    "armed_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      },
      "$comment": "08 SL-2 rule 1: Dart and Lancer ship ids"
    },
    "slots_brf_m": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      },
      "$comment": "08 SL-2 rule 2: (back, right, up) metres in the leader frame"
    },
    "slot_tolerance_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000,
      "$comment": "08 SL-2 rule 2: 30 m"
    },
    "focus_timeout_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 600,
      "$comment": "08 SL-2 rule 3: 20 s"
    },
    "focus_leash_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000,
      "$comment": "08 SL-2 rule 3: 2,000 m"
    },
    "break_radius_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000,
      "$comment": "08 SL-2 rule 3: 1,200 m"
    },
    "break_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 600,
      "$comment": "08 SL-2 rule 3: 20 s"
    },
    "transfer_window_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 60,
      "$comment": "08 SL-2 rule 5: 5 s"
    },
    "transfer_radius_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000,
      "$comment": "08 SL-2 rule 5: 2,500 m"
    }
  },
  "required": [
    "max_wingmen",
    "recruit_radius_m",
    "min_fuel01",
    "min_hp01",
    "min_speed_ratio",
    "recruit_states",
    "armed_classes",
    "slots_brf_m",
    "slot_tolerance_m",
    "focus_timeout_s",
    "focus_leash_m",
    "break_radius_m",
    "break_s",
    "transfer_window_s",
    "transfer_radius_m"
  ],
  "$defs": {
    "doc": {
      "type": "string",
      "$comment": "hash-excluded one-line rationale (ADR-09, 03 s9.4)"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "$comment": "lowercase snake_case, loads as StringName (R0 B)"
    }
  }
}
