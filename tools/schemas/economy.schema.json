{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "economy.schema.json",
  "title": "EconomyDef (godot/content/defs/economy.json)",
  "$comment": "R0 B.1 economy.json; 02 s8.1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "_doc": {
      "$ref": "#/$defs/doc"
    },
    "start_ore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "$comment": "01 anchor 800"
    },
    "start_ice": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000,
      "$comment": "01 anchor 300"
    },
    "start_kit": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "core_trickle_ore_per_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 20,
      "$comment": "01 anchor 1.0"
    },
    "repair_ore_per_hp": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "wreck_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "wreck_lifetime_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 600
    },
    "salvage_pod_max_ore": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "solar_band_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "solar_plateau_mult": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "solar_plateau_radius_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 5000
    },
    "tower_offline_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "unsupplied_rate_mult": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "$comment": "02 s5.4: an unsupplied tower fires at this fraction of its rate (0.5); R0 B.12 A-66 (GD-36 named const until TA-56)"
    },
    "production_min_speed": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "pipe_radius_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 5000
    },
    "refinery_docks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "hauler_transfer_per_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "queue_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "auto_replenish_period_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10,
      "$comment": "02 s6.4 auto-replenish scan period; 1 Hz anchor (A-83), GD-34 may retune"
    },
    "pad_queue_radius_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 3000,
      "$comment": "R0 B.24 A-125: queue zone around a busy pad, horizontal in the pad frame with no altitude term (05 s5.5 L2b 400 m hold + 100 m margin); canonical 500. Must be >= the largest structures/towers pad_radius_m: a cross-file bound, enforced by validate_content.py check_pad_queue_radius (the schema minimum stays 0)"
    },
    "construction_slots_base": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "construction_slots_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "cancel_refund_queued": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cancel_refund_assembly": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "self_repair_delay_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 300
    },
    "self_repair_min_hp_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "self_repair_frac_per_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "early_share_lock_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 1200
    },
    "early_share_ore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "unused_slot_yield": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "build_max_slope_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 90,
      "$comment": "02 s6.2 rule 2: 15 degrees"
    },
    "outpost_presence_radius_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 5000,
      "$comment": "02 s6.2 rule 5(a): 300 m"
    },
    "outpost_spacing_friendly_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 20000,
      "$comment": "02 s6.2 rule 5(b): 800 m"
    },
    "outpost_spacing_enemy_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 20000,
      "$comment": "02 s6.2 rule 5(c): 1500 m"
    },
    "site_hp_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "$comment": "02 s6.3: a site has hp * max(0.1, progress)"
    },
    "start_refinery_dist_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 5000,
      "$comment": "02 s8.1: Refinery 500 m from the Core toward Home Field A"
    },
    "salvage_hook_m": {
      "type": "number",
      "minimum": 1,
      "maximum": 500,
      "$comment": "02 s13 hook reach: a ship with a free tow slot hooks a free wreck whose centre is within this distance (R0 B.20 A-105: tether geometry 25 + 8 m, 05 s6.5 hovers at 30 m AGL)"
    },
    "salvage_deliver_m": {
      "type": "number",
      "minimum": 1,
      "maximum": 500,
      "$comment": "02 s13 delivery reach: a towed wreck is delivered when its ship is within the Refinery radius plus this distance (R0 B.20 A-105)"
    },
    "start_adjacent_dist_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 5000,
      "$comment": "02 s8.1: Shipyard adjacent to the Core, Vehicle Bay beside the Refinery"
    }
  },
  "required": [
    "pad_queue_radius_m",
    "build_max_slope_deg",
    "outpost_presence_radius_m",
    "outpost_spacing_friendly_m",
    "outpost_spacing_enemy_m",
    "site_hp_fraction",
    "salvage_hook_m",
    "salvage_deliver_m",
    "start_adjacent_dist_m",
    "start_refinery_dist_m",
    "cancel_refund_assembly",
    "cancel_refund_queued",
    "construction_slots_base",
    "construction_slots_max",
    "core_trickle_ore_per_s",
    "early_share_lock_s",
    "early_share_ore",
    "hauler_transfer_per_s",
    "pipe_radius_m",
    "production_min_speed",
    "queue_max",
    "auto_replenish_period_s",
    "refinery_docks",
    "repair_ore_per_hp",
    "salvage_pod_max_ore",
    "self_repair_delay_s",
    "self_repair_frac_per_s",
    "self_repair_min_hp_s",
    "solar_band_deg",
    "solar_plateau_mult",
    "solar_plateau_radius_m",
    "start_ice",
    "start_kit",
    "start_ore",
    "tower_offline_ratio",
    "unsupplied_rate_mult",
    "unused_slot_yield",
    "wreck_fraction",
    "wreck_lifetime_s"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "$comment": "lowercase snake_case, loads as StringName (R0 B)"
    },
    "status": {
      "enum": [
        "core",
        "candidate"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "doc": {
      "type": "string",
      "$comment": "hash-excluded one-line rationale (ADR-09, 03 s9.4)"
    },
    "presentation": {
      "type": "object",
      "$comment": "07-owned; stripped from the content hash (03 s9.2). Keys: R0 B.1 ship block + 03 s15.3 PresentationDef + 02 s7 icon.",
      "additionalProperties": false,
      "properties": {
        "mesh": {
          "type": "string"
        },
        "far_mesh_node": {
          "type": "string"
        },
        "vfx": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sfx": {
          "type": "object"
        },
        "smoke_hp01": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chase_distance_m": {
              "type": "number",
              "minimum": 1,
              "maximum": 500
            }
          }
        },
        "budget_tris": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "pool": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "icon": {
          "type": "string"
        }
      }
    }
  }
}
