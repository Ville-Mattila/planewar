{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "callsigns.schema.json",
  "title": "CallsignDef (godot/content/defs/callsigns.json)",
  "$comment": "08 SL-3 rule 1 (FEAT-01). Singleton. Word lists per team slot 0..7 and class key; only slot 0 is in the docs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "_doc": {
      "$ref": "#/$defs/doc"
    },
    "number_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99,
      "$comment": "08 SL-3 rule 1: n = 1 + (hash mod 9)"
    },
    "callsigns": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-7]$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z]*$"
          }
        }
      },
      "$comment": "team_slot -> class_key -> words (08 SL-3 data)"
    }
  },
  "required": [
    "number_count",
    "callsigns"
  ],
  "$defs": {
    "doc": {
      "type": "string",
      "$comment": "hash-excluded one-line rationale (ADR-09, 03 s9.4)"
    }
  }
}
