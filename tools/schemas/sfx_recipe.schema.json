{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sfx_recipe.schema.json",
  "title": "SFX synth recipe (tools/audio/recipes/<sfx_id>.json)",
  "$comment": "07 s8.4: layers of {wave, f0, f_slope, vibrato, attack, sustain, decay, lowpass, highpass, bitcrush, gain, delay}; deterministic by seed. Rendered by tools/audio/sfxgen.py (ART-22). Not a content def: never enters the content hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "seed", "layers"],
  "properties": {
    "_doc": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "sample_rate": {"type": "integer", "enum": [22050]},
    "loop": {"type": "boolean", "$comment": "true: the tail is cross-faded into the head so the file loops without a click"},
    "loop_crossfade_ms": {"type": "number", "minimum": 5, "maximum": 500},
    "normalize_peak_db": {"type": "number", "minimum": -24, "maximum": -1, "$comment": "peak-normalise to this dBFS; absent = no normalisation (hard clip at full scale)"},
    "targets": {"$ref": "#/$defs/targets"},
    "layers": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/layer"}}
  },
  "$defs": {
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lufs": {"type": "number", "minimum": -60, "maximum": 0},
        "lufs_tol": {"type": "number", "minimum": 0, "maximum": 12},
        "centroid_hz": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 11025}},
        "duration_s": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 4}}
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave"],
      "properties": {
        "wave": {"type": "string", "enum": ["sine", "square", "saw", "noise"]},
        "f0": {"type": "number", "minimum": 1, "maximum": 11025, "$comment": "Hz at t = 0 (ignored by noise)"},
        "f_slope": {"type": "number", "minimum": -10, "maximum": 10, "$comment": "octaves per second"},
        "vibrato_hz": {"type": "number", "minimum": 0, "maximum": 40},
        "vibrato_depth": {"type": "number", "minimum": 0, "maximum": 1, "$comment": "fraction of f0"},
        "attack": {"type": "number", "minimum": 0, "maximum": 4},
        "sustain": {"type": "number", "minimum": 0, "maximum": 4},
        "decay": {"type": "number", "minimum": 0, "maximum": 4},
        "lowpass": {"type": "number", "minimum": 20, "maximum": 11000, "$comment": "Hz, 12 dB/oct"},
        "highpass": {"type": "number", "minimum": 20, "maximum": 11000, "$comment": "Hz, 6 dB/oct"},
        "bitcrush": {"type": "integer", "minimum": 2, "maximum": 16, "$comment": "bits"},
        "gain": {"type": "number", "minimum": 0, "maximum": 8, "$comment": "linear"},
        "delay": {"type": "number", "minimum": 0, "maximum": 4, "$comment": "seconds before the layer starts"}
      }
    }
  }
}
