{
  "_doc": "Negative fixtures for tools/validate_content.py. Each case patches one file of canonical/ (path = keys and indices from the file root; op set | del) and must produce a violation containing `expect`. Includes the TA-07 seed list (gravity 20, unknown key, radius_m != 6000, wedge_start_deg != 22.5, duplicate feature id).",
  "cases": [
    {"name": "gravity_20", "file": "godot/content/defs/rules.json", "op": "set", "path": ["gravity"], "value": 20, "expect": "20 > maximum 8.0"},
    {"name": "rules_unknown_key", "file": "godot/content/defs/rules.json", "op": "set", "path": ["salvage_fraction"], "value": 0.4, "expect": "unknown key 'salvage_fraction'"},
    {"name": "rules_missing_key", "file": "godot/content/defs/rules.json", "op": "del", "path": ["lift_model"], "expect": "missing required key 'lift_model'"},
    {"name": "tick_hz_bool", "file": "godot/content/defs/rules.json", "op": "set", "path": ["tick_hz"], "value": true, "expect": "must equal 30"},
    {"name": "lift_model_enum", "file": "godot/content/defs/rules.json", "op": "set", "path": ["lift_model"], "value": "magic", "expect": "is not one of"},
    {"name": "recipe_radius_6001", "file": "godot/content/maps/cradle/recipe.json", "op": "set", "path": ["radius_m"], "value": 6001, "expect": "must equal 6000"},
    {"name": "recipe_wedge_start_20", "file": "godot/content/maps/cradle/recipe.json", "op": "set", "path": ["symmetry", "wedge_start_deg"], "value": 20, "expect": "must equal 22.5"},
    {"name": "recipe_duplicate_feature_id", "file": "godot/content/maps/cradle/recipe.json", "op": "set", "path": ["resources", "ring_features", 1, "id"], "value": "field_a", "expect": "duplicate feature id 'field_a'"},
