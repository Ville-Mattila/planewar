    {"name": "recipe_relief_max_800", "file": "godot/content/maps/cradle/recipe.json", "op": "set", "path": ["relief", "max_m"], "value": 800, "expect": "must equal 700", "sole": true},
    {"name": "recipe_scatter_diam_descending", "file": "godot/content/maps/cradle/recipe.json", "op": "set", "path": ["craters", "scatter", "diam_m"], "value": [600, 60], "expect": "diam_m [600, 60] must be ascending", "sole": true},
    {"name": "recipe_slot_feature_bad_kind", "file": "godot/content/maps/cradle/recipe.json", "op": "set", "path": ["resources", "slot_features", 0, "kind"], "value": "crater", "expect": "is not one of", "sole": true},
