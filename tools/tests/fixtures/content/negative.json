    {"name": "doctrine_bad_op", "file": "godot/content/defs/doctrines.json", "op": "set", "path": ["doctrines", 0, "modifiers", 0, "op"], "value": "pow", "expect": "is not one of"},
    {"name": "mode_unknown_id", "file": "godot/content/defs/modes.json", "op": "set", "path": ["modes", 0, "id"], "value": "pvp_3v3", "expect": "is not one of"},
